@* 说明图标：文案放进 .bocchi-tooltip，悬停、键盘聚焦和轻点都能看到，Esc 关闭，不用浏览器原生 title。
   靠近右边缘时传 Align="end"，提示框右对齐，不会撑出横向滚动。 *@
<button type="button"
        class="bocchi-tooltip bocchi-info-tip"
        aria-label="@Text"
        data-bocchi-tooltip="@Text"
        data-bocchi-tooltip-placement="@Placement"
        data-bocchi-tooltip-align="@(Align == "end" ? "end" : null)">
    <Blazicon Svg="Lucide.Info" />
</button>

@code {
    /// <summary>已经过 i18n 的说明文案。</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>tooltip 位置，目前支持 top 和 bottom。</summary>
    [Parameter] public string Placement { get; set; } = "bottom";

    /// <summary>水平对齐：默认居中；end 表示提示框右边和图标右边对齐。</summary>
    [Parameter] public string? Align { get; set; }
}
