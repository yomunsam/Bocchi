<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>Bocchi.HomeServer</RootNamespace>
    <UserSecretsId>bocchi-home-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Blazicons.Lucide" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Bocchi.ContentModel\Bocchi.ContentModel.csproj" />
    <ProjectReference Include="..\..\Core\Bocchi.Workspace\Bocchi.Workspace.csproj" />
    <ProjectReference Include="..\..\Core\Bocchi.GeneratorContract\Bocchi.GeneratorContract.csproj" />
    <ProjectReference Include="..\..\Core\Bocchi.Generator\Bocchi.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Localization\Dashboard\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 前端包管理文件只参与 Vite/NPM 构建，不是 HomeServer 运行时或发布资产。 -->
    <Content Update="package.json;package-lock.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bocchi.HomeServer.Tests" />
  </ItemGroup>

  <!-- 后台前端产物（Vite 输出）不进仓库：装过 node_modules 时构建前自动 npm run build。 -->
  <Target Name="BuildAdminClientAssets"
          Condition="Exists('package.json') and Exists('node_modules') and '$(BocchiSkipAdminAssetsBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <BocchiAdminClientAsset Include="wwwroot/app.min.css;wwwroot/bocchi-markdown-editor.min.js" />
  </ItemGroup>

  <!-- 产物缺失时直接失败，避免后台在没有样式和编辑器脚本的情况下静默运行。 -->
  <Target Name="EnsureAdminClientAssets"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="BuildAdminClientAssets"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('%(BocchiAdminClientAsset.Identity)')"
           Code="BOCCHI001"
           Text="后台前端资产缺失：%(BocchiAdminClientAsset.Identity)。请在 $(MSBuildProjectDirectory) 下执行 'npm ci'（之后 dotnet build 会自动运行 'npm run build'），或手动执行 'npm ci &amp;&amp; npm run build'。" />
  </Target>

</Project>
